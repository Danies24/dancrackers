# Dan Crackers — environment variables
# Copy to .env.local for local dev (never commit .env.local).
# See PRD §23.4 (environments) and §24.1 (stack) for context.

# ── Supabase ─────────────────────────────────────────────────────────
# Local dev: run `npm run supabase:start` and paste the printed values here.
# Production: from your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in route handlers / server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── WhatsApp (wa.me deep links, §17) ─────────────────────────────────
# 10-digit Indian mobile numbers, no +91, no spaces.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=9800000000
SUPPLIER_WHATSAPP_NUMBER=9800000001

# ── Email — Resend (§18.2) ───────────────────────────────────────────
RESEND_API_KEY=
NOTIFY_EMAIL_DAN=dan@example.com
NOTIFY_EMAIL_ARUN=arun@example.com
RESEND_FROM_EMAIL="Dan Crackers <orders@dancrackersorders.com>"

# ── Telegram bot (§18.2) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Rate limiting — Upstash Redis (§30.2) ────────────────────────────
# Leave blank in local dev: rate limiting no-ops without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics & monitoring (§29, §31) ────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Cron / internal jobs (§18.6 digest) ──────────────────────────────
# Random secret; Vercel Cron sends it as a bearer token to /api/cron/*.
CRON_SECRET=
